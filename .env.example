# ==============================================================================
# VN ALPHA RADAR & PORTFOLIO COCKPIT - ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to `.env` and fill in your real credentials locally.
# NEVER commit `.env` to GitHub or share it in reports/videos.
# ==============================================================================

# --- VPBankS NEO API (Core Data Source) ---
NEO_AUTH_URL=https://external.vpbanks.com.vn/auth/token
NEO_API_BASE_URL=https://neoapi.vpbanks.com.vn/neo-api
NEO_WS_URL=wss://neoapi.vpbanks.com.vn/stock-stream/broker
NEO_USERNAME=your_custody_code_e_g_116C000001
NEO_PASSWORD=your_vpbanks_password_here
NEO_DEVICE_ID=vn-alpha-radar
NEO_DEVICE_TYPE=chrome

# --- SSI FastConnect API v3 (Historical OHLCV Supplement) ---
SSI_FC_BASE_URL=https://api.ssi.com.vn/api/v3
SSI_CONSUMER_ID=your_ssi_consumer_id_here
SSI_CONSUMER_SECRET=your_ssi_consumer_secret_here

# --- Application Settings ---
APP_TIMEZONE=Asia/Ho_Chi_Minh
DATA_MODE=snapshot
SQLITE_DB_PATH=data_sample/market_data.sqlite
LOG_LEVEL=INFO
